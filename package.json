{
  "name": "docker-compose-skeleton-ui",
  "version": "4.0.41",
  "description": "The dashboard of DCS Orchestrator: desktop, browser and Android",
  "type": "module",
  "main": "dist/main/index.cjs",
  "author": {
    "name": "Scott Howson",
    "email": "scott@howson.dev"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"npm run build:main && electron .\"",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --outfile=dist/main/index.cjs --external:electron --format=cjs && esbuild src/main/preload.ts --bundle --platform=node --outfile=dist/main/preload.cjs --external:electron --format=cjs",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:themes": "node scripts/check-themes.mjs",
    "themes:classes": "node scripts/theme-classes.mjs",
    "build": "npm run build:main && npm run build:renderer && electron-builder",
    "preview": "vite preview",
    "electron": "npm run build:main && electron .",
    "cap:sync": "npx cap sync android",
    "build:android": "npm run build:renderer && npx cap sync android && cd android && JAVA_HOME=$HOME/jdk/jdk-21.0.6 ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/status-bar": "^8.0.1",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@xhayper/discord-rpc": "^1.5.1",
    "electron-store": "^8.2.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.14.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.4.1",
    "wait-on": "^8.0.1"
  }
}
